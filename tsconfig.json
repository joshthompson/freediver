{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "types": ["vite/client"],

    // Paths
    "paths": {
      "@/*": ["./src/*"],
      "@style/*": ["./styled-system/*"],
      "@assets/*": ["./src/assets/*"],
      // The game's own Solid for a linked ScoopJS too, or there'd be two JSX namespaces
      "solid-js": ["./node_modules/solid-js"],
      "solid-js/*": ["./node_modules/solid-js/*"]
    }
  }
}
